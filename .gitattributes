# Frozen contracts are hash-pinned in docs/acceptance/gate_versions.md and
# asserted by tests/test_contract_pins.py, so their bytes must not depend on the
# platform that checked them out. Without this a Windows clone silently
# renormalises to CRLF and every pinned SHA-256 is wrong.
#
# Deliberately narrow. The benchmark profiles under eval/ are pinned too, but
# their recorded hashes were computed from CRLF bytes; normalising them here
# would rewrite a frozen benchmark to fix a problem it did not cause.
configs/gates/*.json text eol=lf
configs/aggregation/*.json text eol=lf
configs/aggregation/evaluators/*.json text eol=lf
eval/baselines/*.json text eol=lf
eval/aggregation_behavior.py text eol=lf

# Named one file at a time, deliberately. `configs/run_profiles/*.json` would
# renormalise phase8.json, whose bytes a frozen benchmark pins, and
# `eval/benchmarks/**` would do the same to phase8_profile.json — which is
# exactly how a benchmark was made unrunnable once already.
configs/run_profiles/phase8_batch.json text eol=lf
configs/run_profiles/phase8_batch_v2.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/phase8_batch_profile.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/excerpt_gold_v1.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/phase8_batch_v2_profile.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/excerpt_gold_v2.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/phase8_batch_v3_profile.json text eol=lf
eval/benchmarks/melanoma_checkpoint_2017/d1_7_expected_plan.json text eol=lf
configs/prompt_contracts/*.json text eol=lf
