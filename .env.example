# Copy to .env (gitignored). Do not commit real keys.
REACT_REVIEW_BASIC_USER=reviewer
REACT_REVIEW_BASIC_PASSWORD=change-me
REACT_REVIEW_LLM_API_KEY=
REACT_REVIEW_LLM_BASE_URL=https://api.deepseek.com
# Optional: key for the transcribe gear. Empty means reuse REACT_REVIEW_LLM_API_KEY.
REACT_REVIEW_TRANSCRIBE_API_KEY=
# Optional: second model offered when a checkpoint asks to retry on another model.
REACT_REVIEW_LLM2_API_KEY=
REACT_REVIEW_VISION_API_KEY=
REACT_REVIEW_PUBMED_API_KEY=
REACT_REVIEW_EMAIL=
REACT_REVIEW_MOCK_MODE=false
