{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://react-review.local/schema/table-capture-gold-cell-v1.json",
  "title": "TableCapture gold cell v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "table_id",
    "row_id",
    "column_id",
    "raw_value",
    "normalized_value",
    "blank_kind",
    "source_locator"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "table_id": {"type": "string", "minLength": 1},
    "row_id": {
      "type": "string",
      "pattern": "^(header|data)_[0-9]{2,}$"
    },
    "column_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
    "raw_value": {"type": "string"},
    "normalized_value": {"type": "string"},
    "blank_kind": {
      "enum": ["value", "true_blank", "merged", "not_applicable"]
    },
    "source_locator": {"type": "string", "minLength": 1}
  }
}
