# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.cache/
.tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime artefacts
logs/
output/
*.log
/LOG.txt

# Local config with secrets
config.yaml
config.local.yaml
.env

