.claude/

# OS
.DS_Store
Thumbs.db

# Generated reports (keep report code, not outputs)
*.docx
!docs/**/*.docx

# Large benchmark PDFs are tracked deliberately under eval/benchmark_*/raw/
# (whitelisted below); ignore stray PDFs elsewhere.
*.pdf
!eval/benchmark_1/raw/*.pdf
!eval/benchmark_2/raw/review_karlsson_saleh_2017.pdf
!eval/benchmark_3/raw/*.pdf
